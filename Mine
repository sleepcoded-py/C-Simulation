<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Mini Minecraft</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#87ceeb;font-family:sans-serif}
  #info{position:fixed;left:12px;top:12px;background:#0008;color:#fff;padding:8px 10px;border-radius:6px;font-size:14px;line-height:1.4}
  #cross{position:fixed;left:50%;top:50%;width:20px;height:20px;transform:translate(-50%,-50%);pointer-events:none}
  #cross:before,#cross:after{content:"";position:absolute;background:#fff;box-shadow:0 0 2px #000}
  #cross:before{left:9px;top:0;width:2px;height:20px}
  #cross:after{top:9px;left:0;height:2px;width:20px}
</style>
</head>
<body>
<div id="info">Click to play<br>WASD move · Space jump · Mouse look<br>Left click break · Right click place · Esc release</div>
<div id="cross"></div>

<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);
scene.fog = new THREE.Fog(0x87ceeb, 20, 60);

const camera = new THREE.PerspectiveCamera(75, innerWidth / innerHeight, 0.1, 1000);
camera.rotation.order = 'YXZ';

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 1.2));
const sun = new THREE.DirectionalLight(0xffffff, 1.5);
sun.position.set(10, 20, 10);
scene.add(sun);

const grass = new THREE.MeshLambertMaterial({ color: 0x6ab04c });
const dirt = new THREE.MeshLambertMaterial({ color: 0x8b5a2b });
const blockMats = [dirt, dirt, grass, dirt, dirt, dirt];
const boxGeo = new THREE.BoxGeometry(1, 1, 1);

const blocks = new Map();
const key = (x, y, z) => `${x},${y},${z}`;

function addBlock(x, y, z) {
  if (blocks.has(key(x, y, z))) return;
  const mesh = new THREE.Mesh(boxGeo, blockMats);
  mesh.position.set(x + 0.5, y + 0.5, z + 0.5);
  mesh.userData = { x, y, z };
  scene.add(mesh);
  blocks.set(key(x, y, z), mesh);
}

function removeBlock(mesh) {
  if (!mesh) return;
  scene.remove(mesh);
  blocks.delete(key(mesh.userData.x, mesh.userData.y, mesh.userData.z));
}

for (let x = 0; x < 16; x++) {
  for (let z = 0; z < 16; z++) addBlock(x, 0, z);
}
for (let x = 4; x <= 7; x++) {
  for (let z = 4; z <= 7; z++) addBlock(x, 1, z);
}
for (let x = 5; x <= 6; x++) {
  for (let z = 5; z <= 6; z++) addBlock(x, 2, z);
}

const player = { x: 8.5, y: 1.05, z: 8.5, vy: 0, onGround: false };
const radius = 0.3;
const height = 1.7;
const eye = 1.62;

function collides(px, py, pz) {
  const minX = Math.floor(px - radius);
  const maxX = Math.ceil(px + radius) - 1;
  const minY = Math.floor(py);
  const maxY = Math.ceil(py + height) - 1;
  const minZ = Math.floor(pz - radius);
  const maxZ = Math.ceil(pz + radius) - 1;

  for (let x = minX; x <= maxX; x++) {
    for (let y = minY; y <= maxY; y++) {
      for (let z = minZ; z <= maxZ; z++) {
        if (blocks.has(key(x, y, z))) return true;
      }
    }
  }
  return false;
}

function blockOverlapsPlayer(x, y, z) {
  return (
    player.x + radius > x &&
    player.x - radius < x + 1 &&
    player.y + height > y &&
    player.y < y + 1 &&
    player.z + radius > z &&
    player.z - radius < z + 1
  );
}

let yaw = 0;
let pitch = 0;
const keys = {};

document.addEventListener('mousemove', (e) => {
  if (document.pointerLockElement !== renderer.domElement) return;
  yaw -= e.movementX * 0.0025;
  pitch -= e.movementY * 0.0025;
  pitch = Math.max(-Math.PI / 2 + 0.01, Math.min(Math.PI / 2 - 0.01, pitch));
});

renderer.domElement.addEventListener('click', () => {
  renderer.domElement.requestPointerLock();
});

document.addEventListener('pointerlockchange', () => {
  if (document.pointerLockElement !== renderer.domElement) {
    for (const k in keys) keys[k] = false;
  }
});

addEventListener('keydown', (e) => {
  keys[e.code] = true;
  if (e.code === 'Space') e.preventDefault();
});
addEventListener('keyup', (e) => {
  keys[e.code] = false;
});

const raycaster = new THREE.Raycaster();
const center = new THREE.Vector2(0, 0);

renderer.domElement.addEventListener('mousedown', (e) => {
  if (document.pointerLockElement !== renderer.domElement) return;

  raycaster.setFromCamera(center, camera);
  const hit = raycaster.intersectObjects([...blocks.values()])[0];
  if (!hit || hit.distance > 6) return;

  if (e.button === 0) {
    removeBlock(hit.object);
  } else if (e.button === 2 && hit.face) {
    const n = hit.face.normal;
    const b = hit.object.userData;
    const x = b.x + Math.round(n.x);
    const y = b.y + Math.round(n.y);
    const z = b.z + Math.round(n.z);
    if (!blockOverlapsPlayer(x, y, z)) addBlock(x, y, z);
  }
});

renderer.domElement.addEventListener('contextmenu', (e) => e.preventDefault());

function update(dt) {
  const speed = 4.5;
  const forward = (keys.KeyW ? 1 : 0) - (keys.KeyS ? 1 : 0);
  const strafe = (keys.KeyD ? 1 : 0) - (keys.KeyA ? 1 : 0);

  const sin = Math.sin(yaw);
  const cos = Math.cos(yaw);
  let dx = -sin * forward + cos * strafe;
  let dz = -cos * forward - sin * strafe;

  const len = Math.hypot(dx, dz);
  if (len > 0) {
    dx /= len;
    dz /= len;
  }

  const step = speed * dt;

  const nx = player.x + dx * step;
  if (!collides(nx, player.y, player.z)) player.x = nx;

  const nz = player.z + dz * step;
  if (!collides(player.x, player.y, nz)) player.z = nz;

  player.vy -= 20 * dt;
  const ny = player.y + player.vy * dt;

  if (!collides(player.x, ny, player.z)) {
    player.y = ny;
    player.onGround = false;
  } else {
    if (player.vy < 0) player.onGround = true;
    player.vy = 0;
  }

  if (keys.Space && player.onGround) {
    player.vy = 7;
    player.onGround = false;
  }

  if (player.y < -20) {
    player.x = 8.5;
    player.y = 5;
    player.z = 8.5;
    player.vy = 0;
  }

  camera.position.set(player.x, player.y + eye, player.z);
  camera.rotation.set(pitch, yaw, 0);
}

let last = performance.now();

function loop(now) {
  const dt = Math.min((now - last) / 1000, 0.05);
  last = now;
  update(dt);
  renderer.render(scene, camera);
  requestAnimationFrame(loop);
}

requestAnimationFrame(loop);

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>
